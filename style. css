@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Poppins:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #0b1020;
  --panel: #141c32;
  --panel2: #1a2540;
  --text: #f5f7ff;
  --muted: #aab4cc;
  --purple: #a78bfa;
  --cyan: #5ee7f5;
  --border: rgba(255,255,255,.09);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: Inter, Poppins, sans-serif;
  min-height: 100vh;
}
a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
button { cursor: pointer; }
.topbar {
  height: 76px; padding: 0 7%;
  display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid var(--border);
  background: rgba(11,16,32,.92);
  position: sticky; top: 0; z-index: 20; backdrop-filter: blur(18px);
}
.brand { display: flex; align-items: center; gap: 9px; font-size: 21px; font-weight: 800; }
.brand-icon { color: var(--cyan); font-size: 26px; }
.brand-accent { color: var(--cyan); }
nav { display: flex; gap: 27px; align-items: center; }
nav a { color: var(--muted); font-size: 14px; transition: .2s; }
nav a:hover, nav a.active { color: var(--cyan); }
.lang-btn, .menu-btn {
  color: white; background: var(--panel2); border: 1px solid var(--border);
  padding: 9px 14px; border-radius: 10px;
}
.menu-btn { display: none; }
.hero {
  padding: 75px 8% 85px; display: grid; grid-template-columns: 1.1fr .9fr;
  align-items: center; gap: 30px; overflow: hidden;
  background: radial-gradient(ellipse at 80% 45%, rgba(103,80,210,.2), transparent 42%);
}
.eyebrow { color: var(--cyan); font-size: 11px; letter-spacing: 2px; font-weight: 800; }
.hero h1 { font-size: clamp(38px,5vw,66px); line-height: 1.12; margin: 20px 0; letter-spacing: -2px; }
.gradient-text { background: linear-gradient(90deg,#65e7f3,#a78bfa,#ff9bd2); color: transparent; background-clip: text; }
.hero-copy > p { color: var(--muted); line-height: 1.8; max-width: 510px; }
.hero-actions { display: flex; gap: 13px; margin-top: 28px; flex-wrap: wrap; }
.btn { padding: 13px 19px; border-radius: 11px; font-weight: 700; font-size: 14px; display: inline-flex; gap: 12px; }
.primary { color: #08111e; background: linear-gradient(100deg,#65e7f3,#a78bfa); }
.secondary { border: 1px solid var(--border); background: var(--panel); }
.hero-stats { display: flex; gap: 38px; margin-top: 42px; }
.hero-stats div { display: grid; gap: 5px; }
.hero-stats strong { font-size: 23px; }
.hero-stats small { color: var(--muted); }
.hero-art { height: 370px; position: relative; display: grid; place-items: center; }
.hero-glow { width: 205px; height: 205px; display: grid; place-items: center; border-radius: 50%; font-size: 110px; color: #c6b7ff; background: radial-gradient(circle,#6f5bc8,#282b66 65%,transparent 70%); filter: drop-shadow(0 0 50px #7c6ce0); }
.orbit { position: absolute; width: 300px; height: 300px; border: 1px solid rgba(150,140,255,.35); border-radius: 50%; transform: rotate(-25deg) scaleY(.55); }
.orbit-two { width: 370px; height: 370px; transform: rotate(45deg) scaleY(.48); border-color: rgba(94,231,245,.3); }
.floating-card { position: absolute; background: #202b49; border: 1px solid var(--border); padding: 13px 16px; border-radius: 13px; box-shadow: 0 15px 40px #0005; }
.floating-card span { font-size: 12px; margin-left: 6px; }
.card-top { top: 38px; right: 0; }.card-bottom { bottom: 38px; left: 0; }
.hero-book { position: absolute; font-size: 43px; bottom: 110px; right: 48px; }
.section { padding: 55px 8%; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 25px; }
.section-heading h2 { font-size: clamp(25px,3vw,36px); margin-top: 8px; }
.section-heading p { color: var(--muted); font-size: 13px; }
.feature-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
.feature-card, .model-preview, .class-card, .subject-card {
  border: 1px solid var(--border); border-radius: 17px; padding: 22px;
  background: var(--panel); transition: .25s; display: block;
}
.feature-card:hover, .model-preview:hover, .class-card:hover, .subject-card:hover {
  transform: translateY(-5px); border-color: #8e84ed;
}
.feature-icon { font-size: 31px; display: block; margin-bottom: 20px; }
.feature-card h3, .model-preview h3 { font-size: 17px; margin-bottom: 9px; }
.feature-card p, .model-preview p { color: var(--muted); font-size: 13px; line-height: 1.6; }
.card-arrow { color: var(--cyan); font-size: 12px; display: block; margin-top: 20px; font-weight: 700; }
.purple { background: linear-gradient(145deg,#24204b,var(--panel)); }
.blue { background: linear-gradient(145deg,#173b51,var(--panel)); }
.orange { background: linear-gradient(145deg,#4b3028,var(--panel)); }
.green { background: linear-gradient(145deg,#1d463d,var(--panel)); }
.model-preview-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 17px; }
.model-preview > div { font-size: 48px; margin-bottom: 15px; }
.text-link { color: var(--cyan); font-size: 13px; }
footer { border-top: 1px solid var(--border); padding: 30px 8%; color: var(--muted); text-align: center; }
footer .brand { justify-content: center; color: white; margin-bottom: 9px; }
footer p { font-size: 13px; margin-bottom: 12px; }
footer small { font-size: 11px; }

/* Inner pages */
.page-wrap { max-width: 1150px; padding: 45px 22px 70px; margin: auto; min-height: 70vh; }
.page-title { font-size: clamp(29px,4vw,42px); margin: 10px 0; }
.page-subtitle { color: var(--muted); line-height: 1.7; margin-bottom: 28px; }
.class-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 13px; }
.class-card { text-align: left; cursor: pointer; color: white; }
.class-card strong { font-size: 22px; display: block; color: var(--cyan); margin-bottom: 8px; }
.class-card span { font-size: 12px; color: var(--muted); }
.toolbar { display: flex; gap: 12px; flex-wrap: wrap; margin: 20px 0; }
.field { background: var(--panel); border: 1px solid var(--border); color: white; padding: 12px 14px; border-radius: 10px; min-width: 180px; }
.subject-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
.subject-card { cursor: pointer; }
.subject-card h3 { margin-bottom: 8px; }
.subject-card p { color: var(--muted); font-size: 13px; }
.chapter-list { display: grid; gap: 10px; margin-top: 20px; }
.chapter { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px; display: flex; justify-content: space-between; gap: 12px; align-items: center; }
.chapter button, .small-btn { background: #27375a; border: 0; color: var(--cyan); padding: 9px 13px; border-radius: 8px; }
.lab-layout { display: grid; grid-template-columns: 260px 1fr; gap: 18px; }
.lab-menu { display: grid; gap: 9px; align-content: start; }
.lab-menu button { text-align: left; color: white; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 13px; }
.lab-menu button.active { border-color: var(--cyan); color: var(--cyan); }
.viewer { min-height: 420px; position: relative; border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: radial-gradient(circle at center,#202d50,#101629 70%); }
#modelCanvas { width: 100%; height: 420px; display: block; }
.viewer-label { position: absolute; top: 16px; left: 18px; color: var(--muted); font-size: 12px; pointer-events: none; }
.viewer-help { color: var(--muted); font-size: 12px; margin-top: 10px; }
.resource-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
.resource { padding: 20px; border-radius: 14px; background: var(--panel); border: 1px solid var(--border); }
.resource .emoji { font-size: 30px; margin-bottom: 12px; }
.resource p { color: var(--muted); font-size: 13px; line-height: 1.6; margin: 8px 0 15px; }
.resource a { color: var(--cyan); font-size: 13px; }
.quiz-box { background: var(--panel); padding: 25px; border: 1px solid var(--border); border-radius: 16px; max-width: 700px; }
.quiz-option { display: block; width: 100%; text-align: left; color: white; background: var(--panel2); border: 1px solid var(--border); padding: 13px; border-radius: 10px; margin-top: 10px; }
.quiz-option:hover { border-color: var(--cyan); }
.notice { color: var(--muted); font-size: 12px; margin-top: 18px; line-height: 1.6; }
.back-link { color: var(--cyan); display: inline-block; margin-bottom: 20px; font-size: 13px; }
@media(max-width:850px) {
  .topbar { padding: 0 5%; }
  nav { gap: 13px; }
  .hero { padding: 55px 6%; }
  .feature-grid { grid-template-columns: repeat(2,1fr); }
  .class-grid { grid-template-columns: repeat(3,1fr); }
}
@media(max-width:650px) {
  .topbar { height: 65px; }
  .menu-btn { display: block; margin-left: auto; margin-right: 10px; }
  nav { display: none; position: absolute; top: 65px; left: 0; right: 0; padding: 18px 6%; background: #121a30; flex-direction: column; align-items: flex-start; }
  nav.open { display: flex; }
  .hero { grid-template-columns: 1fr; padding-top: 48px; }
  .hero-art { height: 270px; }
  .hero-glow { width: 150px; height: 150px; font-size: 80px; }
  .orbit { width: 230px; height: 230px; }
  .orbit-two { width: 280px; height: 280px; }
  .hero-stats { gap: 22px; }
  .section { padding: 38px 6%; }
  .section-heading { align-items: flex-start; flex-direction: column; }
  .feature-grid, .model-preview-grid, .subject-grid, .resource-grid { grid-template-columns: 1fr 1fr; }
  .class-grid { grid-template-columns: repeat(2,1fr); }
  .lab-layout { grid-template-columns: 1fr; }
  .lab-menu { grid-template-columns: repeat(2,1fr); }
  .viewer, #modelCanvas { min-height: 330px; height: 330px; }
}
@media(max-width:390px) {
  .feature-grid, .model-preview-grid, .subject-grid, .resource-grid { grid-template-columns: 1fr; }
  }
